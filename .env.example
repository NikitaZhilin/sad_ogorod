BOT_TOKEN=123456:replace-me
APP_ENV=production
APP_VERSION=2026.05.25-local
SEND_STARTUP_UPDATE_ON_BOOT=true
STARTUP_UPDATE_MESSAGE=Добавлен кнопочный интерфейс Telegram-бота.
TESTING_NOTICE_ENABLED=true
TESTING_NOTICE_TEXT=⚠️ Бот находится в тестировании. Данные могут быть изменены или утеряны.
DATABASE_PATH=/app/data/ogorodom.sqlite3
BACKUP_DIR=/app/backups
LOG_LEVEL=INFO
POLL_TIMEOUT_SECONDS=30
WORKER_INTERVAL_SECONDS=30
DEFAULT_TIMEZONE=Europe/Moscow
DEFAULT_QUIET_START=22:00
DEFAULT_QUIET_END=08:00
REMINDER_LEAD_MINUTES=60
