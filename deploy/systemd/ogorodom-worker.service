[Unit]
Description=Ogorodom reminder worker
After=network-online.target ogorodom-bot.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/ogorodom
EnvironmentFile=/opt/ogorodom/.env
Environment=PYTHONPATH=/opt/ogorodom/src
ExecStart=/opt/ogorodom/.venv/bin/python -m ogorodom_bot.worker
Restart=always
RestartSec=5
User=ogorodom
Group=ogorodom

[Install]
WantedBy=multi-user.target
